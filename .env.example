# Isla environment template.
#
# Copy this file to `.env` and fill in the values THERE. `.env` is ignored by
# git (see .gitignore); this template is the only committed environment file and
# it documents variable NAMES only - never values. Do not paste a real
# credential into this file, into a commit message, or into a test fixture.
#
# The application never parses `.env` itself: every module takes `env` as an
# injected argument (for example `resolveStorageConfig(env)` and
# `createProductionDeployment({ env })`). Load the file into the shell instead:
#
#   set -a; . ./.env; set +a
#
# A deployment module may live outside this checkout, so the provider choice and
# its credential never enter the repository.

# --- Production entry (src/runtime/production-cli.ts) -----------------------
# Absolute path of the module exporting `createProductionDeployment`. The module
# receives `{ clock, databasePath, env }` and returns the peer ports, including
# the M4 `DialogueTextSource`. Keep it outside this checkout when it names a
# provider or reads a credential.
ISLA_DEPLOYMENT_MODULE=

# --- Storage and server (M6 / M5) -------------------------------------------
# Default: .cache/isla/isla.db (kept outside OneDrive).
ISLA_STORAGE_DB_PATH=
ISLA_RUNTIME_HOST=
ISLA_RUNTIME_PORT=

# --- Live text provider (M4-02) ---------------------------------------------
# OpenAI-compatible chat endpoint. Tests under test/live/ read these three names
# through test/live/live-config.ts; an unset or blank value makes the live suite
# skip rather than fail. A missing key must never fall back to the fixture
# source in production code.
ISLA_LIVE_TEXT_BASE_URL=
ISLA_LIVE_TEXT_MODEL=
ISLA_LIVE_TEXT_API_KEY=

# --- Optional: live browser checks (M1) -------------------------------------
# Playwright package directory and Chromium executable, required only for the
# browser live checks on machines that do not have them installed.
ISLA_PLAYWRIGHT_PATH=
ISLA_CHROMIUM_PATH=
