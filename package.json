    "test:m1": "vitest run test/offline/m1-performance.test.ts test/offline/m1-kokoro-worker-entry.test.ts",
    "test:m2": "vitest run test/offline/m2-console.test.ts",
    "test:m3": "vitest run test/offline/m3-decision.test.ts",
    "test:m4": "vitest run test/offline/m4-dialogue.test.ts test/offline/m4-storage-integration.test.ts",
    "test:m5": "vitest run test/offline/m5-runtime.test.ts test/offline/m5-coordinator.test.ts",
    "test:m6": "vitest run test/offline/m6-storage.test.ts test/offline/m6-storage-properties.test.ts test/offline/m6-sqlite.test.ts test/offline/m6-sqlite-backend.test.ts test/offline/m6-recovery.test.ts test/offline/m6-durability.test.ts test/offline/m6-02-metrics.test.ts test/offline/m6-02-comparison.test.ts test/offline/m6-02-report.test.ts test/offline/m6-02-boundary.test.ts",
    "test:composition": "vitest run test/offline/composition.test.ts",
    "test:readiness": "vitest run test/offline/contracts.test.ts test/offline/requirements.test.ts test/offline/boundaries.test.ts",
    "test:trace": "vitest run test/offline/trace-fitness.test.ts",
