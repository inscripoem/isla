    "gate:change-base": "tsx src/evaluation/change-range.ts",
    "gate:eval": "tsx src/evaluation/eval-gate.ts",
    "gate:test-approval": "tsx src/evaluation/test-approval-gate.ts",
    "req:schema": "tsx src/evaluation/emit-req-schema.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@huggingface/transformers": "3.5.1",
    "kokoro-js": "1.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
